# BFF Proxy configuration — copy to .env and fill in values

# ── Non-sensitive config (safe to commit per environment) ─────────────────────
PORT=3001
LOG_LEVEL=info
JWT_TTL=28800
PORTAL_ORIGINS=http://localhost:8081,http://localhost:3000
SESSION_STORE_TYPE=memory

# ── Secrets (must come from a secrets manager or CI env in production) ────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-char-string

# ── Optional: Redis (required when SESSION_STORE_TYPE=redis) ──────────────────
# REDIS_URL=redis://localhost:6379
